prototype(Kleisli.Neos.DocumentCollection:Document.DocumentCollection) < prototype(Neos.Fusion:Component) {

    defaultView = 'list'

    listViewConfiguration = Neos.Fusion:DataStructure {
        sortingBy = '_creationdatetime'
        sortingDirection = 'DESC'
        showProperties = Neos.Fusion:DataStructure
    }

    layoutView = Neos.Neos:Page {
        head.stylesheets.documentCollection = Kleisli.Neos.DocumentCollection:Document.Head.BackendStylesheets
        body = 'Define a layoutView in your Document prototype.'
        body.@process.documentCollection = Kleisli.Neos.DocumentCollection:Process.PrependAdminBar {
            header.currentView = 'layout'
        }
    }

    renderer = Neos.Fusion:Case {
        layoutView {
            @position = "start"
            condition =  ${!documentNode.context.inBackend || request.arguments.view == 'layout' || (props.defaultView == 'layout' && request.arguments.view != 'list')}
            renderer = ${props.layoutView}
        }

        default {
            @position = "end"
            condition = true
            renderer = Neos.Neos:Page {
                head.stylesheets.documentCollection = Kleisli.Neos.DocumentCollection:Document.Head.BackendStylesheets
                bodyTag.attributes.class = "neos neos-module"

                body = Neos.Fusion:Component {
                    documents = Neos.Fusion:Loop {
                        items = ${q(node).children('[instanceof Neos.Neos:Document]').sort(props.listViewConfiguration.sortingBy, props.listViewConfiguration.sortingDirection)}
                        itemName = 'document'
                        itemRenderer = Neos.Fusion:Component {
                            @apply.props = ${props}
                            icon = ${document.nodeType.fullConfiguration.ui.icon}
                            renderer = afx`
                                <tr class={(document.hiddenInIndex ? 'document-hiddenInIndex ':'')+(document.hidden ? 'document-hidden ':'')}>
                                    <td>
                                        <Neos.Fusion:Fragment @if={document.nodeData.hiddenAfterDateTime && document.nodeData.hiddenAfterDateTime < document.context.currentDateTime
                                            || document.nodeData.hiddenBeforeDateTime && document.nodeData.hiddenBeforeDateTime > document.context.currentDateTime}>
                                            <NeosLoves.Iconify:Icon name="fa7-solid:clock" renderer.style={"color:#ff8181; vertical-align: middle;margin-right: 0.5rem;"}/>
                                        </Neos.Fusion:Fragment>
                                        <Neos.Fusion:Fragment @if={document.hidden}>
                                            <NeosLoves.Iconify:Icon name="fa7-solid:circle-xmark" renderer.style={"color:#ff8181; vertical-align: middle;margin-right: 0.5rem;"}/>
                                        </Neos.Fusion:Fragment>
                                        <Neos.Neos:NodeLink node={document}>
                                            <Kleisli.Neos.DocumentCollection:Component.NodeIcon node={document} style="font-size: 1rem;  vertical-align: middle;margin-right: 0.25rem;" />
                                            {document.properties.title}
                                        </Neos.Neos:NodeLink>
                                    </td>
                                    <Neos.Fusion:Loop items={props.listViewConfiguration.showProperties} itemName="propertyRenderer" itemKey="propertyName">
                                        <td>
                                            <Kleisli.Neos.DocumentCollection:Component.NodePropertyDisplayer node={document} propertyName={propertyName}/>
                                        </td>
                                    </Neos.Fusion:Loop>

                                </tr>
                            `
                        }
                    }
                    documents.@process.table = ${'<table class="neos-table">'+value+'</table>'}

                    renderer = afx`
                        <Kleisli.Neos.DocumentCollection:Component.AdminBar currentView='list' />
                        <div class="neos-module-wrap">
                            <div class="neos-content neos-fluid-container neos-indented">
                                <h1 style="font-size: 1.5rem; margin-bottom:0.5rem">
                                    <Kleisli.Neos.DocumentCollection:Component.NodeIcon node={documentNode} class="test" style="margin-right: 0.5rem; vertical-align: middle;" />
                                    {documentNode.properties.title}
                                </h1>
                                {props.documents}
                            </div></div>
                    `
                }
            }
        }
    }

    @cache {
        mode = 'dynamic'
        entryIdentifier {
            node = ${node}
        }
        entryDiscriminator = ${request.arguments.view}
        context {
            1 = 'node'
            2 = 'documentNode'
            3 = 'site'
        }
    }

}
